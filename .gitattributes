# Normalize line endings: LF in the repository and in working trees
* text=auto eol=lf

# Windows-only scripts and texts opened by users in Notepad
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
packaging/*.txt text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.zip binary
*.exe binary
*.dll binary
*.gif binary
*.mp4 binary

# Generated files: keep out of diffs and language stats
Cargo.lock linguist-generated=true -diff
